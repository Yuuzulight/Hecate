# - The ** matters. Docker matches a bare `__pycache__/` at the top level only,
#   so without it the compiled files under pipeline/ ship in the image.
**/__pycache__/
**/*.py[cod]

.venv/
venv/
.git/
.gitignore
.pytest_cache/
.coverage
htmlcov/
coverage.xml
tests/
k8s/
docs/
.env
*.md

# - dbt/ is deliberately not excluded: the dbt stage copies it. The pipeline
#   stage simply never does, so it costs that image nothing.
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
