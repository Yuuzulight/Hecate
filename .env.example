# Copy to .env and fill in. .env is gitignored.

# Database. Defaults match docker-compose.yml, so only the password has to be set.
# If you already run PostgreSQL on 5432, set this to something free (5433 works)
# rather than fighting over the port - docker-compose reads DB_PORT too.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dataflow
DB_PASSWORD=dataflow
DB_NAME=hecate

# API credentials. Both are optional - without them the extractors fall back to
# unauthenticated access, which has a much lower rate limit.
GITHUB_TOKEN=
GITLAB_TOKEN=

# Registries. Only worth changing if you're pointing at a mirror.
NPM_REGISTRY=https://registry.npmjs.org
PYPI_REGISTRY=https://pypi.org

# How many records to pull per source per run, and how many times to retry a
# failed request before giving up on it.
BATCH_SIZE=100
RETRY_ATTEMPTS=3

# Set to 1 to run the tests that need a live database. Left unset they skip;
# set, a database that won't accept us is a failure rather than a silent pass.
HECATE_INTEGRATION=

# Where retrieved context and embeddings are cached. Unset is a working
# configuration: the retriever answers from PostgreSQL and nothing is embedded.
REDIS_URL=

# Two jobs: always used by the embedding job and the similarity block
# regardless of RAG_PROVIDER, and also what RAG_PROVIDER=openai needs for
# answering/judging. Unset, the embedding job says so and exits non-zero,
# and RAG_PROVIDER=openai fails with a clear error instead.
OPENAI_API_KEY=

# Which LLM answers questions and judges the answers, both drawn from the same
# provider via pipeline/rag/providers.py. Defaults to gemini - see
# GOOGLE_API_KEY below for what that default actually needs.
RAG_PROVIDER=

# What the default RAG_PROVIDER=gemini actually needs. Get this from AI
# Studio (aistudio.google.com) specifically for the free path - a Google
# Cloud Console project (console.cloud.google.com) is not the same thing and
# often requires billing enabled for the Gemini API, which can still hit its
# own quota/prepay limits independently of anything in this codebase.
GOOGLE_API_KEY=

# Only needed if RAG_PROVIDER=anthropic. Separate balance from a Claude
# subscription - there is no supported path from one to the other.
ANTHROPIC_API_KEY=
