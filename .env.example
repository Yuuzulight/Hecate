# Copy to .env and fill in. .env is gitignored.

# Database. Defaults match docker-compose.yml, so only the password has to be set.
# If you already run PostgreSQL on 5432, set this to something free (5433 works)
# rather than fighting over the port - docker-compose reads DB_PORT too.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dataflow
DB_PASSWORD=dataflow
DB_NAME=hecate

# API credentials. Both are optional - without them the extractors fall back to
# unauthenticated access, which has a much lower rate limit.
GITHUB_TOKEN=
GITLAB_TOKEN=

# Registries. Only worth changing if you're pointing at a mirror.
NPM_REGISTRY=https://registry.npmjs.org
PYPI_REGISTRY=https://pypi.org

# How many records to pull per source per run, and how many times to retry a
# failed request before giving up on it.
BATCH_SIZE=100
RETRY_ATTEMPTS=3

# Set to 1 to run the tests that need a live database. Left unset they skip;
# set, a database that won't accept us is a failure rather than a silent pass.
HECATE_INTEGRATION=

# Where retrieved context and embeddings are cached. Unset is a working
# configuration: the retriever answers from PostgreSQL and nothing is embedded.
REDIS_URL=

# Only used by the embedding job and the similarity block. Unset, that job says
# so and exits non-zero, and questions are answered from the structured blocks
# alone - which is what carries the answers anyway.
OPENAI_API_KEY=

# Answering questions, and judging the answers. Both the chain and the RAGAS
# judge use this one key - the evaluation deliberately does not fall back to
# OpenAI, which would be a second key and a second bill arriving quietly.
ANTHROPIC_API_KEY=
